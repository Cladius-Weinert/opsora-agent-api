# ==============================================================================
# Opsora Agent API — Environment Variables
# Copy this file to .env and fill in the real values:
#   cp .env.example .env
# ==============================================================================

# ---- API Keys (at least one required) ----

# NVIDIA NIM API key (primary provider — required)
# Get yours at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter API key (fallback provider — optional)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DashScope (Alibaba Cloud) API key (fallback provider — optional)
# Get yours at: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Authentication ----

# Opsora client API keys — comma-separated list of tokens clients use as Bearer auth
# Leave empty to allow all requests (DEV MODE ONLY — never empty in production!)
OPSORA_API_KEYS=opsk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shell tool (run_command) guard.
# Default (unset): run_command is DISABLED when OPSORA_API_KEYS is empty (open
#   dev mode), because an unauthenticated shell is a remote-code-execution hole.
# Set to 0/false/no/off to force-enable, or 1/true/yes/on to force-disable.
OPSORA_DISABLE_RUN_COMMAND=

# ---- Server Settings ----

# Bind address (0.0.0.0 for Docker, 127.0.0.1 for local dev behind nginx)
HOST=0.0.0.0

# Bind port
PORT=8080

# Upstream request timeout in seconds
UPSTREAM_TIMEOUT=120

# ---- Rate Limiting ----

# Requests per minute per API key (sliding window)
RATE_LIMIT_RPM=60

# ---- Database ----

# Path to SQLite database file (for usage tracking)
DB_PATH=./opsora_usage.db

# ---- Billing ----

# Path to billing SQLite database
BILLING_DB_PATH=./billing.db

# IDR to USD exchange rate (used for pricing display)
IDR_USD_RATE=16100

# Midtrans payment gateway (https://dashboard.midtrans.com)
# Server key for Snap API — sandbox key starts with SB-Mid-server-
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Set to "false" for production
MIDTRANS_SANDBOX=true

# ---- CORS ----

# Allowed CORS origins (comma-separated). Use * for all (not recommended in production)
CORS_ORIGINS=https://opsora.id,https://www.opsora.id,https://dashboard.opsora.id

# ---- Logging ----

# Log level: debug, info, warning, error, critical
LOG_LEVEL=info

# ---- NVIDIA Base URL (advanced — usually no need to change) ----
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/
